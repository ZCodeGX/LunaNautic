import io
import json
import path
import string
import table

let ARCHIVO = path.join("datos", "estadisticas.json")

fn por_defecto():
    return { partidas = 0, victorias = 0, mejor = 0, racha = 0, mejor_racha = 0 }

pub fn cargar():
    let stats = por_defecto()
    if not io.exists(ARCHIVO):
        return stats
    try:
        let datos = json.decode(io.read(ARCHIVO))
        if type(datos) == "table":
            if table.has(datos, "partidas"):
                stats.partidas = datos.partidas
            if table.has(datos, "victorias"):
                stats.victorias = datos.victorias
            if table.has(datos, "mejor"):
                stats.mejor = datos.mejor
            if table.has(datos, "racha"):
                stats.racha = datos.racha
            if table.has(datos, "mejor_racha"):
                stats.mejor_racha = datos.mejor_racha
    catch e:
        print(string.concat(" No se pudieron leer las estadísticas: ", e))
    return stats

pub fn guardar(stats):
    try:
        io.ensure_dir("datos")
        io.write(ARCHIVO, json.encode(stats))
        return true
    catch e:
        print(string.concat(" No se pudieron guardar las estadísticas: ", e))
        return false

pub fn registrar(stats, gano, turnos):
    stats.partidas += 1
    if gano:
        stats.victorias += 1
        stats.racha += 1
        if stats.racha > stats.mejor_racha:
            stats.mejor_racha = stats.racha
        if stats.mejor == 0 or turnos < stats.mejor:
            stats.mejor = turnos
    else:
        stats.racha = 0
    return stats
